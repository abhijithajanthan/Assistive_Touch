<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_bg"
    android:padding="8dp"
    android:elevation="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Media"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnVolDown"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_minus"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Media volume down" />

        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_mute"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Mute media" />

        <ImageButton
            android:id="@+id/btnVolUp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_plus"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Media volume up" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ringer"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnRingDown"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_minus"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Ringer volume down" />

        <ImageButton
            android:id="@+id/btnRingUp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_plus"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Ringer volume up" />
    </LinearLayout>

</LinearLayout>
